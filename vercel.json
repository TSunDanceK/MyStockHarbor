{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mystockharbour.com"
        }
      ],
      "destination": "https://mystockharbor.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mystockharbour.com"
        }
      ],
      "destination": "https://mystockharbor.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/jobs/warm-picker-universe",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/warm-earnings",
      "schedule": "*/5 * * * *"
    }
  ]
}
